            <div className="col-span-2 md:col-span-2 text-right flex justify-end">
              <SortButton 
                label="Age Skew" 
                active={sortConfig.key === 'avgAge'} 
                direction={sortConfig.direction} 
                onClick={() => handleSort('avgAge')}
              />
            </div>
          </div>

          {sortedSectorData.map((sector, index) => (
            <div key={index} className={`grid grid-cols-12 gap-4 items-center bg-slate-750 p-3 rounded-lg border transition-colors group ${sector.type === 'non-market' ? 'border-amber-900/30 bg-amber-900/5 hover:bg-amber-900/10' : 'border-slate-700/50 hover:bg-slate-700 hover:border-red-500/30'}`}>
              
              {/* Left: Name & Share */}
              <div className="col-span-5 md:col-span-4">
                <div className="flex items-center gap-3">
                  <div className={`p-2 rounded ${sector.type === 'non-market' ? 'bg-amber-900/20 text-amber-400' : 'bg-slate-800 text-red-400'}`}>
                    <sector.icon size={18} />
                  </div>
                  <div>
                    <div className="font-bold text-slate-200 text-sm md:text-base flex items-center gap-2">
                      {sector.name}
                      {sector.type === 'non-market' && <span className="text-[10px] bg-amber-900/40 text-amber-300 px-1.5 py-0.5 rounded uppercase tracking-wide">Non-Market</span>}
                    </div>
                    <div className="text-xs text-slate-400 flex flex-col md:flex-row md:items-center gap-1 md:gap-3">
                      <span title="Approx. number of people">
                        <Users size={10} className="inline mr-1 text-slate-500" />
                        <span className="text-slate-300 font-bold">
                          {((sector.share / 100) * ESTIMATED_TOTAL_POPULATION).toFixed(2)}M
                        </span>
                      </span>
                      {sector.type === 'market' && (
                        <>
                          <span className="hidden md:inline text-slate-600">|</span>
                          <span title="Share of GDP">
                            <DollarSign size={10} className="inline mr-1 text-emerald-500" />
                            <span className="text-emerald-400 font-mono">
                              {sector.gdpShare}% GDP
                            </span>
                          </span>
                        </>
                      )}
                    </div>
                  </div>
                </div>
              </div>

              {/* Middle: Stacked Wealth Bar */}
              <div className="col-span-5 md:col-span-6">
                <div className="flex justify-between text-[10px] text-slate-400 mb-1 px-1 opacity-0 group-hover:opacity-100 transition-opacity">
                   <span>HDB 1-3 Rm</span>
                   <span>Pvt/Landed</span>
                </div>
                <div className="h-6 w-full flex rounded overflow-hidden bg-slate-900 ring-1 ring-slate-700/50">
                  {/* Bottom Segment */}
                  <div 
                    style={{ width: `${sector.bottom}%` }} 
                    className="h-full bg-amber-500/80 hover:bg-amber-500 flex items-center justify-center text-[10px] font-bold text-slate-900 transition-all"
                    title={`HDB 1-3 Room / Foreign Worker Dorms: ${sector.bottom}%`}
                  >
                    {sector.bottom > 15 && `${sector.bottom}%`}
                  </div>
                  {/* Middle Segment */}
                  <div 
                    style={{ width: `${sector.middle}%` }} 
                    className="h-full bg-blue-500/80 hover:bg-blue-500 flex items-center justify-center text-[10px] font-bold text-white transition-all"
                    title={`HDB 4-5 Room / EC: ${sector.middle}%`}
                  >
                    {sector.middle > 15 && `${sector.middle}%`}
                  </div>
                  {/* Top Segment */}
                  <div 
                    style={{ width: `${sector.top}%` }} 
                    className="h-full bg-emerald-500/80 hover:bg-emerald-500 flex items-center justify-center text-[10px] font-bold text-slate-900 transition-all"
                    title={`Private Condo / Landed: ${sector.top}%`}
                  >
                    {sector.top > 10 && `${sector.top}%`}
                  </div>
                </div>
                <div className="text-[10px] text-slate-500 mt-1 truncate hidden md:block">
                  {sector.desc}
                </div>
              </div>

              {/* Right: Age Skew */}
              <div className="col-span-2 md:col-span-2 text-right">
                <span className="inline-block px-2 py-1 rounded bg-slate-800 text-xs font-medium text-slate-300 border border-slate-600">
                  {sector.ageLabel}
                </span>
              </div>

            </div>
          ))}
          
          <div className="flex justify-center gap-6 mt-4 text-xs text-slate-400 pt-4 border-t border-slate-700/50">
             <div className="flex items-center gap-2">
               <div className="w-3 h-3 bg-amber-500 rounded-sm"></div> HDB 1-3 Rm / Dorms
             </div>
             <div className="flex items-center gap-2">
               <div className="w-3 h-3 bg-blue-500 rounded-sm"></div> HDB 4-5 Rm / EC
             </div>
             <div className="flex items-center gap-2">
               <div className="w-3 h-3 bg-emerald-500 rounded-sm"></div> Private / Landed
             </div>
          </div>

        </div>
      </div>

    </div>
  );
}
