// Heuristic to estimate wealth distribution by age bracket in SG
const getWealthDistribution = (ageGroup: string) => {
  const ageStart = parseInt(ageGroup.split('-')[0].replace('+', ''));
  
  if (ageStart < 25) {
    // NSF/Student: Low wealth
    return { bottom: 90, middle: 9, top: 1 };
  } else if (ageStart < 35) {
    // BTO saving phase / Career start
    return { bottom: 60, middle: 35, top: 5 };
  } else if (ageStart < 55) {
    // Peak Earnings + Property Appreciation
    return { bottom: 30, middle: 55, top: 15 };
  } else {
    // CPF Release / Downgrading for cash
    return { bottom: 40, middle: 50, top: 10 };
  }
};

