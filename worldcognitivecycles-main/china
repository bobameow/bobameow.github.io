          </div>

          {sortedSectorData.map((sector, index) => (
            <div key={index} className={`grid grid-cols-12 gap-4 items-center bg-slate-750 p-3 rounded-lg border transition-colors group ${sector.type === 'non-market' ? 'border-slate-700 bg-slate-800/30' : 'border-slate-700/50 hover:bg-slate-700 hover:border-red-500/30'}`}>
              
              {/* Left: Name & Share */}
              <div className="col-span-5 md:col-span-4">
                <div className="flex items-center gap-3">
                  <div className={`p-2 rounded ${sector.type === 'non-market' ? 'bg-slate-800 text-slate-400' : 'bg-slate-800 text-red-400'}`}>
                    <sector.icon size={18} />
                  </div>
                  <div>
                    <div className="font-bold text-slate-200 text-sm md:text-base flex items-center gap-2">
                      {sector.name}
                      {sector.type === 'non-market' && <span className="text-[10px] bg-slate-700 text-slate-400 px-1.5 py-0.5 rounded uppercase tracking-wide">Non-Market</span>}
                    </div>
                    <div className="text-xs text-slate-400 flex flex-col md:flex-row md:items-center gap-1 md:gap-3">
                      <span title="Approx. number of people">
                        <Users size={10} className="inline mr-1 text-slate-500" />
                        <span className="text-slate-300 font-bold">
                          {((sector.share / 100) * ESTIMATED_TOTAL_POPULATION).toFixed(0)}M
                        </span>
                      </span>
                      {sector.type === 'market' && (
                        <>
                          <span className="hidden md:inline text-slate-600">|</span>
                          <span title="Share of GDP">
                            <DollarSign size={10} className="inline mr-1 text-yellow-500" />
                            <span className="text-yellow-400 font-mono">
                              {sector.gdpShare}% GDP
                            </span>
                          </span>
                        </>
                      )}
                    </div>
                  </div>
                </div>
              </div>

              {/* Middle: Stacked Wealth Bar */}
              <div className="col-span-5 md:col-span-6">
                <div className="h-6 w-full flex rounded overflow-hidden bg-slate-900 ring-1 ring-slate-700/50">
                  <div 
                    style={{ width: `${sector.bottom}%` }} 
                    className="h-full bg-slate-600 hover:bg-slate-500 flex items-center justify-center text-[10px] font-bold text-slate-100 transition-all"
                  >
                    {sector.bottom > 15 && `${sector.bottom}%`}
                  </div>
                  <div 
                    style={{ width: `${sector.middle}%` }} 
                    className="h-full bg-yellow-600 hover:bg-yellow-500 flex items-center justify-center text-[10px] font-bold text-white transition-all"
                  >
                    {sector.middle > 15 && `${sector.middle}%`}
                  </div>
                  <div 
                    style={{ width: `${sector.top}%` }} 
                    className="h-full bg-red-600 hover:bg-red-500 flex items-center justify-center text-[10px] font-bold text-white transition-all"
                  >
                    {sector.top > 10 && `${sector.top}%`}
                  </div>
                </div>
                <div className="text-[10px] text-slate-500 mt-1 truncate hidden md:block">
                  {sector.desc}
                </div>
              </div>

              {/* Right: Age Skew */}
              <div className="col-span-2 md:col-span-2 text-right">
                <span className="inline-block px-2 py-1 rounded bg-slate-800 text-xs font-medium text-slate-300 border border-slate-600">
                  {sector.ageLabel}
                </span>
              </div>

            </div>
          ))}
          
          <div className="flex justify-center gap-6 mt-4 text-xs text-slate-400 pt-4 border-t border-slate-700/50">
             <div className="flex items-center gap-2">
               <div className="w-3 h-3 bg-slate-600 rounded-sm"></div> Bottom 50%
             </div>
             <div className="flex items-center gap-2">
               <div className="w-3 h-3 bg-yellow-600 rounded-sm"></div> Middle 40%
             </div>
             <div className="flex items-center gap-2">
               <div className="w-3 h-3 bg-red-600 rounded-sm"></div> Top 10%
             </div>
          </div>

        </div>
      </div>

    </div>
  );
}
