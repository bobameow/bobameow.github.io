// --- HELPER LOGIC ---

const getWealthDistribution = (ageGroup: string) => {
  const ageStart = parseInt(ageGroup.split('-')[0].replace('+', ''));
  
  if (ageStart < 25) {
    return { bottom: 80, middle: 18, top: 2 }; // Family dependent
  } else if (ageStart < 40) {
    return { bottom: 50, middle: 45, top: 5 }; // Urban accumulators
  } else if (ageStart < 60) {
    return { bottom: 40, middle: 50, top: 10 }; // Peak earning / property owners
  } else {
    return { bottom: 50, middle: 40, top: 10 }; // Retirement inequality
  }
};

