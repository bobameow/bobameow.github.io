// --- HELPER LOGIC ---

// Heuristic to estimate wealth distribution by age bracket
const getWealthDistribution = (ageGroup: string) => {
  const ageStart = parseInt(ageGroup.split('-')[0].replace('+', ''));
  
  if (ageStart < 25) {
    // Young adults: mostly building human capital, low financial capital
    return { bottom: 85, middle: 14, top: 1 };
  } else if (ageStart < 40) {
    // Early/Mid Career: Accumulating
    return { bottom: 60, middle: 35, top: 5 };
  } else if (ageStart < 60) {
    // Peak Earnings
    return { bottom: 40, middle: 50, top: 10 };
  } else {
    // Retirement / Accumulated Wealth
    return { bottom: 30, middle: 55, top: 15 };
  }
};

